{
  "name": "rokka-render",
  "version": "0.10.2",
  "description": "JavaScript client library for just some render functions of rokka.io",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "unpkg": "dist/index.umd.min.js",
  "jsdelivr": "dist/index.umd.min.js",
  "files": [
    "/dist/*",
    "/src/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "npm run lint && npm run jest",
    "lint": "eslint '{src,tests,docs}/**/*.{js,ts}'",
    "lint:fix": "eslint '{src,tests,docs}/**/*.{js,ts}'  --fix",
    "jest": "jest",
    "docs": "node ./docs/generate.mjs",
    "compile": "rm -rf ./dist && rollup -c rollup.config.mjs",
    "watch": "rollup -c rollup.config.mjs -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rokka-io/rokka.js.git"
  },
  "keywords": [
    "rokka",
    "client",
    "browser",
    "node.js"
  ],
  "author": "rokka <rokka@rokka.io>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rokka-io/rokka-render.js/issues"
  },
  "homepage": "https://github.com/rokka-io/rokka-render.js#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/btoa": "^1.2.3",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "5.26.0",
    "@typescript-eslint/parser": "5.26.0",
    "eslint": "^8.15.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^29.7.0",
    "prettier": "^2.6.2",
    "rollup": "^4.59.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-jest": "^29.4.6",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "^5.9.3"
  }
}
